{
  "name": "mavisland/laravel-translator",
  "description": "Synchronize missing Laravel PHP and JSON translation keys",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Thiago Cordeiro",
      "email": "thiagoguetten@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "laravel/framework": "^11.0 || ^12.0 || ^13.0",
    "nikic/php-parser": "^5.0"
  },
  "require-dev": {
    "slevomat/coding-standard": "^8.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "scripts": {
    "test:cs": "vendor/bin/phpcs --colors -ps",
    "test:stan": "vendor/bin/phpstan analyse src --level=max --ansi",
    "test:unit": "vendor/bin/phpunit --testdox --color=always",
    "tests": [
      "@test:cs",
      "@test:stan",
      "@test:unit"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "autoload": {
    "psr-4": {
      "Translator\\": "src/"
    },
    "files": [
      "src/Framework/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Translator\\Tests\\": "tests"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Translator\\Framework\\TranslatorServiceProvider"
      ]
    }
  }
}
